{
  "name": "@xmdrizzol/drizzol-ui",
  "version": "0.2.1",
  "description": "Drizzol UI - Vue 3 组件库（组件、工具、样式、主题）",
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "component-library",
    "drizzol"
  ],
  "license": "MIT",
  "author": "XMDrizzol",
  "type": "module",
  "main": "./dist/drizzol-ui.cjs",
  "module": "./dist/drizzol-ui.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/drizzol-ui.js",
      "require": "./dist/drizzol-ui.cjs"
    },
    "./style.css": "./dist/style.css",
    "./styles": "./dist/styles/index.scss",
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly && node scripts/copy-styles.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "vue-router": {
      "optional": true
    }
  },
  "dependencies": {
    "@cropper/element-canvas": "^2.1.1",
    "@cropper/element-image": "^2.1.1",
    "artplayer": "^5.4.0",
    "axios": "^1.16.0",
    "cropperjs": "^2.1.1",
    "js-cookie": "^3.0.7"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "sass": "^1.99.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.10",
    "vitest": "^5.0.0",
    "vue": "^3.5.32",
    "vue-tsc": "~3.2.8"
  }
}
